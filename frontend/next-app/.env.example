# Frontend environment template.
# Copy to .env.local and fill in real values. Do not commit secrets.
# See AGENTS.md section 12 for the full variable list.

# Quick Demo Access panel on /login ("Quick Demo Access" / "เข้าระบบทดลอง").
# Renders only when this is the exact string true. Unset or any other value
# hides the panel (fail closed). NEXT_PUBLIC_* is inlined at build time —
# redeploy after changing it.
# Set to true ONLY on the demo Vercel project (hr-ims / hrims-pro.vercel.app).
NEXT_PUBLIC_DEMO_MODE=
