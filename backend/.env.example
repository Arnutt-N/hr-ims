# HR-IMS Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# SQLite (development). Must point at the same file the frontend uses.
DATABASE_URL="file:./prisma/dev.db"

# --- Auth ---
JWT_SECRET=change-me

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Redis / Queues (BullMQ) ---
REDIS_URL=redis://localhost:6379

# Background worker process (npm run dev:worker / npm run start:worker)
# Set to false to run only the API server without background jobs.
WORKER_ENABLED=true
# Cron for the maintenance escalation sweep (default: hourly at :00).
MAINTENANCE_ESCALATION_CRON=0 * * * *

# --- Search (optional) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Telegram alerts (optional; escalation alerts fail silent if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- TiDB pipeline (optional; production cutover) ---
TIDB_DATABASE_URL=
