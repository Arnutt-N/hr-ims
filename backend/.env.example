# HR-IMS Backend — environment template
# Copy to .env and fill in real values:  cp .env.example .env

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Dev-only MySQL 8 from docker-compose (service name: mysql). Not a production secret.
# Frontend DATABASE_URL must be the same database. Production TiDB uses this same
# variable (mysql:// scheme); do not commit a real production URL.
DATABASE_URL="mysql://root:root@localhost:3306/hrims"

# --- Auth ---
JWT_SECRET=change-me

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Redis / Queues (BullMQ) ---
REDIS_URL=redis://localhost:6379

# Background worker process (npm run dev:worker / npm run start:worker)
# Set to false on an instance that must not run background jobs:
# when started, the worker process logs and exits immediately.
WORKER_ENABLED=true
# Cron for the maintenance escalation sweep (default: hourly at :00).
MAINTENANCE_ESCALATION_CRON=0 * * * *

# --- Search (optional) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# --- Telegram alerts (optional; escalation alerts fail silent if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Production TiDB uses DATABASE_URL above (mysql://...@host:4000/db?sslaccept=strict).
# There is no separate TIDB_DATABASE_URL. npm run db:push:prod / db:seed:prod
# read DATABASE_URL only. Point that variable at TiDB when pushing production,
# and point it back at the local MySQL URL for development.
